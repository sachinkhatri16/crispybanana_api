generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model game_rounds {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            Int
  puzzle_url         String
  solution           Int
  status             String    @default("in_progress") @db.VarChar(20)
  user_answer        Int?
  is_correct         Boolean?
  score_awarded      Int       @default(0)
  time_limit_seconds Int       @default(30)
  time_taken_ms      Int?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  completed_at       DateTime? @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_game_rounds_created_at")
  @@index([status], map: "idx_game_rounds_status")
  @@index([user_id], map: "idx_game_rounds_user_id")
}

model user_metrics {
  user_id          Int       @id
  total_games      Int       @default(0)
  total_wins       Int       @default(0)
  total_score      Int       @default(0)
  highest_score    Int       @default(0)
  current_streak   Int       @default(0)
  best_streak      Int       @default(0)
  fastest_solve_ms Int?
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id            Int           @id @default(autoincrement())
  username      String        @unique @db.VarChar(50)
  email         String        @unique @db.VarChar(255)
  password_hash String        @db.VarChar(255)
  avatar        String?       @default("adventurer") @db.VarChar(100)
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?     @default(now()) @db.Timestamptz(6)
  game_rounds   game_rounds[]
  user_metrics  user_metrics?

  @@index([email], map: "idx_users_email")
  @@index([username], map: "idx_users_username")
}
